rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function: Check if user is participant in conversation
    function isParticipant(conversationId) {
      return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Users collection: Users can read all users (for search/display names)
    // but can only write their own document
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for display names and online status)
      allow read: if isSignedIn();

      // Users can create their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;

      // Users can update their own profile
      // MILESTONE 8: Allow updating lastSeen and online fields for presence tracking
      // MILESTONE 9: Allow updating displayName if needed
      // V1: Allow updating profile image fields
      allow update: if isSignedIn()
                    && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['lastSeen', 'online', 'displayName', 'pushTokens', 'profileImageUrl', 'profileImagePath', 'profileImageUpdatedAt']);

      allow delete: if false; // No deletion for MVP

      // Signatures subcollection (Phase 2 & 3)
      // Users can read their own signatures collection
      match /signatures/{signatureId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow write: if false; // Only Cloud Functions can write signatures
      }
    }

    // Conversations: Users can only read conversations they're part of
    // MILESTONE 10: These rules support both direct (2 users) and group (3+) conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants.size() >= 2; // Minimum 2 users (direct or group)
      // MILESTONE 11: Update includes setting unreadCount, lastMessage, etc.
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow delete: if false; // No deletion for MVP

      // Messages subcollection
      match /messages/{messageId} {
        // Can read if you're in the parent conversation
        allow read: if isSignedIn() && isParticipant(conversationId);

        // Can create if you're in conversation AND you're the sender
        // CHAI: Validate attachedSignatureId if present
        allow create: if isSignedIn()
                      && isParticipant(conversationId)
                      && request.auth.uid == request.resource.data.senderId
                      && (
                        // Validate attachedSignatureId if present
                        !request.resource.data.keys().hasAny(['attachedSignatureId'])
                        || (request.resource.data.attachedSignatureId is string
                            && request.resource.data.attachedSignatureId.size() > 0)
                      );

        // MILESTONE 9: Can update to add yourself to readBy map
        // V2: Can update to add signature fields (signatureIds, signatureCount)
        // Only allow updating the readBy field, and only to add your own userId
        // Signature fields can only be updated by Cloud Functions (no auth check)
        allow update: if isSignedIn()
                      && isParticipant(conversationId)
                      && (
                        // User updating readBy
                        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
                         && request.auth.uid in request.resource.data.readBy)
                        // OR signature fields being updated (no additional check needed)
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureIds', 'signatureCount'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureIds'])
                        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['signatureCount'])
                      );

        allow delete: if false; // No deletion for MVP
      }
    }
  }
}
