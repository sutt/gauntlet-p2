# Firebase Configuration
# Copy this file to .env.local and fill in your actual values
# Get these from Firebase Console > Project Settings > General > Your apps

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Emulator Configuration (for local development)
# Set to 'true' to use local Firebase emulators instead of production
# Set to 'false' or comment out to use production Firebase
EXPO_PUBLIC_USE_EMULATOR=false

# Emulator Hosts and Ports
# Default values work for most setups. Change only if needed.
# Note: Use 10.0.2.2 instead of localhost when running on Android emulator
EXPO_PUBLIC_AUTH_EMULATOR_HOST=localhost
EXPO_PUBLIC_AUTH_EMULATOR_PORT=9099
EXPO_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost
EXPO_PUBLIC_FIRESTORE_EMULATOR_PORT=8080
EXPO_PUBLIC_FUNCTIONS_EMULATOR_HOST=localhost
EXPO_PUBLIC_FUNCTIONS_EMULATOR_PORT=5001
