# OpenAI API Key for local development
# Copy this file to .env.local and fill in your actual API key
# Get your key from: https://platform.openai.com/api-keys
#
# Note: .env.local is NOT deployed to production
# Production uses Firebase Secret Manager instead

OPENAI_API_KEY=sk-your-openai-api-key-here

# Disable authentication check for local shell testing
# WARNING: Only use for firebase functions:shell testing! Never in production!
# Set to 'true' to test functions without authentication via shell
# Set to 'false' (or omit) to enforce authentication (recommended for emulator testing)
DISABLE_AUTH_CHECK=false
